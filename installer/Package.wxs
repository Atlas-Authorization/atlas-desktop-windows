<?xml version="1.0" encoding="utf-8"?>
<!--
  Atlas Login Agent installer (WiX v4). Build with:  wix build Package.wxs -arch x64 -d Version=0.1.0 -d BinDir=<dir with the three binaries>

  Properties:
    INSTANCE_URL, PUBLISHABLE_KEY, INSTANCE_ID   written to %ProgramData%\Atlas\config.json (HTTPS URL required)
    FAIL_OPEN_WHEN_NEVER_SYNCED=1                allow password-only sign-in on a PC that has never synced (default: refuse)
    FAIL_CLOSED_HIDE=1                           hide the stock password tile even before the first sync
    HIDE_WINDOWS_HELLO=1 / HIDE_SMART_CARD=1     also hide Windows Hello / smart-card sign-in while the stock tiles are hidden
    BREAK_GLASS_ACCOUNTS=AtlasBreakGlass         comma separated local accounts that skip the Atlas step (audited; see ROLLBACK.md)
    CHROME_EXTENSION_ID / FIREFOX_EXTENSION_ID   register the device sign-in native-messaging host for that browser extension (optional)

  Also installed: the AtlasCliMfa service (command-line MFA over a named pipe; atlas-cli-mfa.exe), the AtlasMfa PowerShell module,
  enable-sshd-mfa.ps1, and per-user scheduled tasks for the device-bound SSO broker (atlas-sso-broker.exe).

  The stock password tile is hidden by an ICredentialProviderFilter inside the provider DLL, and only while a cached
  policy says MFA is required. If the DLL does not load, nothing is hidden.

  The provider DLL is installed under %ProgramFiles%\Atlas\LoginAgent, never System32.
  Safety: HKLM\SOFTWARE\Atlas\LoginAgent\Disabled = 1 turns the provider into a pure pass-through (see ROLLBACK.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Atlas Login Agent" Manufacturer="Atlas" Version="$(var.Version)"
           UpgradeCode="6C2F0B7E-3D41-4E8A-A9B5-1F7D5E2C8A64" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of the Atlas Login Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Launch Condition="VersionNT64 &gt;= 603" Message="The Atlas Login Agent needs 64-bit Windows 10 or later." />

    <Property Id="INSTANCE_URL" Secure="yes" />
    <Property Id="PUBLISHABLE_KEY" Secure="yes" />
    <Property Id="INSTANCE_ID" Secure="yes" />
    <Property Id="FAIL_OPEN_WHEN_NEVER_SYNCED" Value="0" Secure="yes" />
    <Property Id="FAIL_CLOSED_HIDE" Value="0" Secure="yes" />
    <Property Id="HIDE_WINDOWS_HELLO" Value="0" Secure="yes" />
    <Property Id="HIDE_SMART_CARD" Value="0" Secure="yes" />
    <Property Id="BREAK_GLASS_ACCOUNTS" Secure="yes" />
    <Property Id="CHROME_EXTENSION_ID" Secure="yes" />
    <Property Id="FIREFOX_EXTENSION_ID" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AtlasDir" Name="Atlas">
        <Directory Id="INSTALLFOLDER" Name="LoginAgent">
          <Directory Id="MODULEDIR" Name="AtlasMfa" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <!-- The COM class and the Credential Providers entry are registered together with the DLL. -->
      <Component Id="ProviderDll" Bitness="always64">
        <File Id="ProviderDllFile" Source="$(var.BinDir)\atlas_credential_provider.dll" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{C3B1A0E6-6D1F-4B0E-9C57-2F1B7A9D4E58}" Type="string" Value="Atlas Login Agent" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{C3B1A0E6-6D1F-4B0E-9C57-2F1B7A9D4E58}\InprocServer32" Type="string" Value="[#ProviderDllFile]" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{C3B1A0E6-6D1F-4B0E-9C57-2F1B7A9D4E58}\InprocServer32" Name="ThreadingModel" Type="string" Value="Apartment" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{C3B1A0E6-6D1F-4B0E-9C57-2F1B7A9D4E58}" Type="string" Value="Atlas Login Agent" />
        <!-- Same CLSID as a credential provider filter: hides the stock password tiles when MFA is required. -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Provider Filters\{C3B1A0E6-6D1F-4B0E-9C57-2F1B7A9D4E58}" Type="string" Value="Atlas Login Agent" />
        <!-- Event log source for break-glass audit events -->
        <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\AtlasLoginAgent" Name="EventMessageFile" Type="expandable" Value="%SystemRoot%\System32\EventCreate.exe" />
        <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\AtlasLoginAgent" Name="TypesSupported" Type="integer" Value="7" />
      </Component>
      <Component Id="EnrollExe" Bitness="always64">
        <File Id="EnrollExeFile" Source="$(var.BinDir)\atlas-enroll.exe" KeyPath="yes" />
      </Component>
      <Component Id="SyncExe" Bitness="always64">
        <File Id="PasskeyExeFile" Source="$(var.BinDir)\atlas-passkey.exe" />
        <File Id="SyncExeFile" Source="$(var.BinDir)\atlas-sync.exe" KeyPath="yes" />
      </Component>
      <!-- Command-line MFA: a LocalSystem service holds the keys; clients (check, ssh-wrap) talk to it over a pipe. -->
      <Component Id="CliMfaExe" Bitness="always64">
        <File Id="CliMfaExeFile" Source="$(var.BinDir)\atlas-cli-mfa.exe" KeyPath="yes" />
        <ServiceInstall Id="CliMfaService" Name="AtlasCliMfa" DisplayName="Atlas command-line MFA" Description="Second factor for OpenSSH and PowerShell sessions"
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Arguments="service" />
        <ServiceControl Id="CliMfaServiceControl" Name="AtlasCliMfa" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="SsoBrokerExe" Bitness="always64">
        <File Id="SsoBrokerExeFile" Source="$(var.BinDir)\atlas-sso-broker.exe" KeyPath="yes" />
        <File Id="SsoNativeHostFile" Source="$(var.BinDir)\atlas-sso-native-host.exe" />
      </Component>
      <Component Id="SsoSupportFiles" Bitness="always64">
        <File Id="SsoLogonTaskXml" Source="atlas-sso-logon-task.xml" KeyPath="yes" />
        <File Id="SsoRefreshTaskXml" Source="atlas-sso-refresh-task.xml" />
        <File Id="EnableSshdScript" Source="enable-sshd-mfa.ps1" />
        <File Id="RegisterNativeHostScript" Source="register-native-host.ps1" />
        <File Id="ExtManifest" Source="..\browser-extension\manifest.json" />
        <File Id="ExtBackground" Source="..\browser-extension\background.js" />
      </Component>
      <Component Id="SupportFiles" Bitness="always64">
        <File Id="SyncTaskXml" Source="atlas-sync-task.xml" KeyPath="yes" />
        <File Id="ConfigTemplate" Source="config.template.json" />
        <File Id="BreakGlassScript" Source="create-break-glass.ps1" />
      </Component>
      <!-- Present so admins can find it; NeverOverwrite keeps a value they set during an incident across repairs. -->
      <Component Id="KillSwitch" Bitness="always64" NeverOverwrite="yes">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Atlas\LoginAgent" Name="Disabled" Type="integer" Value="0" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ModuleFiles" Directory="MODULEDIR">
      <Component Id="AtlasMfaModule" Bitness="always64">
        <File Id="AtlasMfaPsd1" Source="AtlasMfa\AtlasMfa.psd1" KeyPath="yes" />
        <File Id="AtlasMfaPsm1" Source="AtlasMfa\AtlasMfa.psm1" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Atlas Login Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentGroupRef Id="ModuleFiles" />
    </Feature>

    <!-- config.json from the MSI properties (left alone if this PC is already enrolled) -->
    <CustomAction Id="WriteConfig" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[INSTALLFOLDER]atlas-enroll.exe&quot; --write-config --fail-open &quot;[FAIL_OPEN_WHEN_NEVER_SYNCED]&quot; --fail-closed-hide &quot;[FAIL_CLOSED_HIDE]&quot; --hide-windows-hello &quot;[HIDE_WINDOWS_HELLO]&quot; --hide-smart-card &quot;[HIDE_SMART_CARD]&quot; --break-glass &quot;[BREAK_GLASS_ACCOUNTS]&quot; --instance-url &quot;[INSTANCE_URL]&quot; --publishable-key &quot;[PUBLISHABLE_KEY]&quot; --instance-id &quot;[INSTANCE_ID]&quot;" />
    <CustomAction Id="CreateSyncTask" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Create /TN &quot;Atlas\LoginAgentSync&quot; /XML &quot;[INSTALLFOLDER]atlas-sync-task.xml&quot; /F" />
    <CustomAction Id="DeleteSyncTask" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Delete /TN &quot;Atlas\LoginAgentSync&quot; /F" />

    <CustomAction Id="CreateSsoTasks" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -Command &quot;schtasks /Create /TN 'Atlas\DeviceSsoLogon' /XML '[INSTALLFOLDER]atlas-sso-logon-task.xml' /F; if ($LASTEXITCODE) { exit 1 }; schtasks /Create /TN 'Atlas\DeviceSsoRefresh' /XML '[INSTALLFOLDER]atlas-sso-refresh-task.xml' /F&quot;" />
    <CustomAction Id="DeleteSsoTasks" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -Command &quot;schtasks /Delete /TN 'Atlas\DeviceSsoLogon' /F; schtasks /Delete /TN 'Atlas\DeviceSsoRefresh' /F&quot;" />
    <CustomAction Id="RegisterNativeHost" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]register-native-host.ps1&quot; -ChromeExtensionId &quot;[CHROME_EXTENSION_ID]&quot; -FirefoxExtensionId &quot;[FIREFOX_EXTENSION_ID]&quot;" />
    <CustomAction Id="UnregisterNativeHost" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]register-native-host.ps1&quot; -Remove" />

    <InstallExecuteSequence>
      <Custom Action="CreateSsoTasks" After="CreateSyncTask" Condition="NOT Installed" />
      <Custom Action="RegisterNativeHost" After="CreateSsoTasks" Condition="NOT Installed AND (CHROME_EXTENSION_ID &lt;&gt; &quot;&quot; OR FIREFOX_EXTENSION_ID &lt;&gt; &quot;&quot;)" />
      <Custom Action="DeleteSsoTasks" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UnregisterNativeHost" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="WriteConfig" After="InstallFiles" Condition="NOT Installed AND INSTANCE_URL &lt;&gt; &quot;&quot;" />
      <Custom Action="CreateSyncTask" After="WriteConfig" Condition="NOT Installed" />
      <!-- Uninstall: drop the task first; the registry entries are removed with their components, which unregisters the provider. -->
      <Custom Action="DeleteSyncTask" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
